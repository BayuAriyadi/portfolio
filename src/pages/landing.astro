---
import { site } from '../data/config';

const links = [
  { label: 'Portfolio', href: 'https://portfolio.pujin.my.id', arrow: true },
  { label: 'Blog', href: 'https://pujin.my.id/blog', arrow: true },
  { label: 'GitHub', href: 'https://github.com/BayuAriyadi', arrow: true },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content="CS Graduate, Homelab Builder, AI Enthusiast" />
  <title>{site.brand}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #090a0f;
      --card: #12131c;
      --border: #1e2030;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --accent: #10b981;
      --accent-dim: #059669;
      --accent-glow: rgba(16, 185, 129, 0.12);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
    }

    .wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 2rem;
    }

    /* Brand */
    .brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.75rem;
    }

    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--accent);
      flex-shrink: 0;
    }

    .brand-name {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text);
    }

    .tagline {
      font-size: 0.9rem;
      color: var(--muted);
      text-align: center;
      margin-bottom: 2.5rem;
      font-family: 'Fira Code', monospace;
    }

    /* Link cards */
    .links {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      width: 100%;
      max-width: 600px;
      margin-bottom: 3rem;
    }

    .card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem 1.75rem;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--text);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.95rem;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
      border-color: var(--accent);
      box-shadow: 0 0 20px var(--accent-glow);
    }

    .card:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .card .arrow {
      color: var(--accent);
      font-size: 1.1rem;
      flex-shrink: 0;
    }

    /* Footer */
    .footer {
      font-size: 0.8rem;
      color: var(--muted);
      opacity: 0.6;
    }

    @media (max-width: 600px) {
      .links {
        grid-template-columns: 1fr;
        max-width: 320px;
      }

      .tagline { font-size: 0.8rem; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="brand">
      <span class="dot" aria-hidden="true"></span>
      <span class="brand-name">{site.brand}</span>
    </div>
    <p class="tagline">CS Graduate | Homelab Builder | AI Enthusiast</p>
    <nav class="links" aria-label="Main links">
      {links.map(l => (
        <a class="card" href={l.href}>
          <span>{l.label}</span>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </nav>
    <footer class="footer">&copy; 2026 Bayu Ariyadi &middot; Built with Astro</footer>
  </div>
</body>
</html>
